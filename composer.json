{
    "name": "vinelab/neoeloquent",
    "description": "Laravel wrapper for the Neo4j graph database REST interface",
    "keywords": [
        "neo4j",
        "ogm",
        "graph",
        "database",
        "neoeloquent"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Abed Halawi",
            "email": "abed.halawi@vinelab.com"
        },
        {
            "name": "Kinane Domloje",
            "email": "kinane@vinelab.com"
        }
    ],
    "require": {
    "php": ">=7.1",
    "illuminate/support": "^5.7",
    "illuminate/database": "^5.7",
    "illuminate/events": "^5.7"
    },
    "require-dev": {
        "mockery/mockery": "~1.3.0",
        "phpunit/phpunit": "^9.0",
        "symfony/var-dumper": "*",
        "fzaninotto/faker": "~1.4",
        "composer/composer": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Vinelab\\NeoEloquent\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vinelab\\NeoEloquent\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "extra": {
        "laravel": {
            "providers": [
                "Vinelab\\NeoEloquent\\NeoEloquentServiceProvider"
            ]
        }
    }
}
